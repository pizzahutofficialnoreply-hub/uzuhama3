# Frontend Environment Variables (Vite)
# Sensitive secrets (CRON_SECRET, FIREBASE_PRIVATE_KEY, etc.) are managed in Vercel Environment Variables.
VITE_YOUTUBE_API_KEY=
# Set to the Vercel deployment URL when the frontend is hosted on another domain.
VITE_VERCEL_API_URL=
# Copy the Web Push public key from Firebase Console > Project settings > Cloud Messaging.
VITE_VAPID_PUBLIC_KEY=

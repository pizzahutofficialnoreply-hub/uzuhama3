{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "unsafe-none"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/api/calendar.ics",
        "destination": "https://uzuhama.vercel.app/api/calendar.ics?siteUrl=https%3A%2F%2Fuzuhama.web.app",
        "type": 301
      },
      {
        "source": "/feed.ics",
        "destination": "https://uzuhama.vercel.app/api/calendar.ics?siteUrl=https%3A%2F%2Fuzuhama.web.app",
        "type": 301
      },
      {
        "source": "/api/:path*",
        "destination": "https://uzuhama.vercel.app/api/:path",
        "type": 307
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
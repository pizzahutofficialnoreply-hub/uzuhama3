{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "api/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/feed.ics",
      "destination": "/api/calendar.ics"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "icn1"
  ]
}
